#!/bin/bash
# Helper script to manage Jev Gemini Local Proxy

PID_FILE="$HOME/.config/jev-cli/proxy.pid"
LOG_FILE="$HOME/.config/jev-cli/proxy.log"
SCRIPT="$(cd "$(dirname "$0")" && pwd)/jev_proxy.py"
KEY_FILE="$HOME/.config/jev-cli/gemini_key.txt"
# python3 on Windows is often a Store stub that runs nothing; use the first interpreter that works.
PY=python3; "$PY" -c "" 2>/dev/null || PY=python

case "$1" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "Jev Proxy is already running (PID: $(cat "$PID_FILE"))."
      exit 0
    fi
    mkdir -p "$HOME/.config/jev-cli"
    nohup "$PY" "$SCRIPT" > "$LOG_FILE" 2>&1 &
    PID=$!
    echo "$PID" > "$PID_FILE"
    sleep 0.5
    if kill -0 "$PID" 2>/dev/null; then
      echo "Jev Gemini Proxy started successfully (PID: $PID) at http://127.0.0.1:8765/v1/systemone"
    else
      echo "Failed to start Jev Proxy. Check logs at $LOG_FILE"
      exit 1
    fi
    ;;

  stop)
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then
        kill "$PID"
        echo "Stopped Jev Proxy (PID: $PID)."
      else
        echo "Jev Proxy is not running."
      fi
      rm -f "$PID_FILE"
    else
      # Check if running by port or process
      pkill -f "jev_proxy.py" && echo "Killed orphaned proxy processes." || echo "Jev Proxy is not running."
    fi
    ;;

  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;

  status)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "Jev Proxy is running (PID: $(cat "$PID_FILE"))."
      curl -s http://127.0.0.1:8765/health && echo ""
    else
      echo "Jev Proxy is STOPPED."
    fi
    ;;

  set-key)
    if [ -z "$2" ]; then
      echo "Usage: jev-proxy set-key <GEMINI_API_KEY>"
      exit 1
    fi
    mkdir -p "$HOME/.config/jev-cli"
    echo "$2" > "$KEY_FILE"
    chmod 600 "$KEY_FILE"
    echo "Gemini API key saved to $KEY_FILE."
    ;;

  logs)
    tail -n 30 -f "$LOG_FILE"
    ;;

  *)
    echo "Usage: jev-proxy {start|stop|restart|status|set-key <KEY>|logs}"
    exit 1
    ;;
esac
